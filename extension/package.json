{
  "name": "event-to-calendar-extension",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LOSU-369/calendar-plugin.git",
    "directory": "extension"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/release-check.ps1",
    "package": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/package-extension.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.276",
    "@types/node": "^22.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.5.4",
    "vite": "^8.0.13"
  }
}
